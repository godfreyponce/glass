# GitHub write path for the /new form (used by app/api/projects/route.ts)
# A fine-grained PAT scoped to ONLY the portfolio repo, Contents: read & write.
GITHUB_TOKEN=
GITHUB_OWNER=godfreyponce
GITHUB_REPO=glass
GITHUB_BRANCH=main

# Private card store: repo name (same owner/token) holding projects/*.md for
# private cards (climbing, TrackerDash). Leave empty to disable the private store.
GITHUB_PRIVATE_REPO=

# Passphrase the /new form must send; validated server-side. Set a long random string.
API_WRITE_SECRET=
APP_PASSWORD=change-me
SESSION_SECRET=at-least-32-chars-random-string
